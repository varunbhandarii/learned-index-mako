+  // ---- learned-index-mako: tables whose keys live in ALEX ----
+  //
+  // Values are the same versioned_value objects Masstree tables use, so reads, writes,
+  // install, unlock and cleanup work unchanged. What differs is phantom protection:
+  // instead of observing Masstree node versions, a transaction observes the ALEX index's
+  // structural version on every miss and scan, and check() fails if any key was inserted
+  // or erased since. That is coarser than per-node validation, but tables that suit ALEX
+  // (TPC-C item, stock, warehouse, district) have no inserts after loading.
+
+  static constexpr uintptr_t alex_version_bit = 1 << 1;  // pointers here are 8-byte aligned
+
+  versioned_value* alex_version_key() const {
+    return reinterpret_cast<versioned_value*>(reinterpret_cast<uintptr_t>(alex_.get()) |
+                                              alex_version_bit);
+  }
+  static bool is_alex_version(const TransItem& item) {
+    return reinterpret_cast<uintptr_t>(item.key<versioned_value*>()) & alex_version_bit;
+  }
+
+  template <typename K>
+  static std::string_view key_view(const K& key) {
+    Str s(key);
+    return std::string_view(s.data(), s.length());
+  }
+
+  template <typename K>
+  versioned_value* alex_find(const K& key, uint64_t* version) const {
+    return static_cast<versioned_value*>(alex_->find(key_view(key), version));
+  }
+
+  void observe_alex_version(uint64_t version) {
+    auto item = t_read_only_item(alex_version_key());
+    if (Opacity)
+      item.add_read_opaque(version);
+    else
+      item.add_read(version);
+  }
+
+  // Like updateNodeVersion(): this transaction's own insert must not invalidate a version
+  // it observed just before.
+  void update_alex_version(uint64_t old_version, uint64_t new_version) {
+    if (auto item = Sto::check_item(this, alex_version_key())) {
+      if (item->has_read() && item->template read_value<uint64_t>() == old_version)
+        item->update_read(old_version, new_version);
+    }
+  }
+
+  template <typename K>
+  [[noreturn]] void alex_bad_key(const K& key) const {
+    std::cerr << "[learned-index-mako] table " << table_name_ << ": a "
+              << key_view(key).size() << "-byte key does not fit its ALEX index (all keys "
+              << "must have the same length, at most " << lim::AlexIndex::kMaxKeyLen
+              << " bytes). Remove the table from MAKO_ALEX_TABLES." << std::endl;
+    std::abort();
+  }
+
+  // trans_write() for ALEX tables, following the Masstree path: an existing key goes
+  // through handlePutFound(), and a new key is inserted at once with invalid_bit set, so
+  // other transactions treat it as uncommitted until install() clears the bit.
+  template <bool INSERT, bool SET, typename StringType, typename ValueType>
+  bool alex_trans_write(const StringType& key, const ValueType& value,
+                        bool(*compar)(const std::string& newValue, const std::string& oldValue)) {
+    uint64_t version = 0;
+    versioned_value *e = alex_find(key, &version);
+    if (!e) {
+      if (!INSERT) {
+        observe_alex_version(version);
+        return false;
+      }
+      versioned_value* val = (versioned_value*)versioned_value::make(value, invalid_bit);
+      auto r = alex_->insert_if_absent(key_view(key), val);
+      if (r.status == lim::AlexIndex::InsertStatus::kInserted) {
+        update_alex_version(r.old_version, r.new_version);
+        auto item = Sto::new_item(this, val);
+        item.template add_write<key_write_value_type>(key).add_flags(insert_bit);
+        return false;  // like the Masstree path: "found" is false for a new key
+      }
+      if (r.status == lim::AlexIndex::InsertStatus::kBadKey)
+        alex_bad_key(key);
+      val->deallocate_rcu(*mythreadinfo.ti);  // never published
+      e = static_cast<versioned_value*>(r.existing);  // another transaction inserted it first
+    }
+    if (compar != nullptr && !compar(value, e->read_value()))
+      return false;
+    return handlePutFound<INSERT, SET>(e, key, value);
+  }
+
+  // Range scan with Masstree's semantics: forward visits begin <= key < end, reverse visits
+  // begin >= key > end, and an empty end means no bound. Entries are copied out in batches
+  // so that no index lock is held while value_callback runs.
+  template <bool Reverse, typename ValueCallback>
+  void alex_scan(Str begin, Str end, ValueCallback& value_callback) {
+    std::string_view stop(end.data(), end.length());
+    const std::string_view* stop_ptr = end ? &stop : nullptr;
+    lim::AlexIndex::ScanState state;
+    lim::AlexIndex::Entry batch[64];
+    char key[lim::AlexIndex::kMaxKeyLen];
+    bool observed = false;
+    while (!state.done) {
+      size_t n = Reverse ? alex_->rscan(key_view(begin), stop_ptr, &state, batch, 64)
+                         : alex_->scan(key_view(begin), stop_ptr, &state, batch, 64);
+      if (state.conflict)
+        Sto::abort();
+      if (!observed) {
+        observe_alex_version(state.version);
+        observed = true;
+      }
+      for (size_t i = 0; i < n; ++i) {
+        size_t len = lim::AlexIndex::decode(batch[i].code, state.key_len, key);
+        if (!value_callback(Str(key, len), static_cast<versioned_value*>(batch[i].value)))
+          return;
+      }
+    }
+  }
+
