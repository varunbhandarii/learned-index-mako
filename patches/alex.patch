diff --git a/src/core/alex_base.h b/src/core/alex_base.h
index 82ae846..6acd722 100644
--- a/src/core/alex_base.h
+++ b/src/core/alex_base.h
@@ -51,6 +51,20 @@ typedef unsigned __int32 uint32_t;
 #define forceinline inline
 #endif
 
+// Lookups update statistics (lookup counts, search iterations) that ALEX's cost model uses
+// when it later restructures nodes. Those writes make concurrent lookups a data race even
+// under a shared lock, and make reader threads contend for the same cache lines. Defining
+// ALEX_TRACK_LOOKUP_STATS=0 compiles them out (inserts share the search routines, so their
+// search-iteration counts go too); the default keeps ALEX's original behaviour.
+#ifndef ALEX_TRACK_LOOKUP_STATS
+#define ALEX_TRACK_LOOKUP_STATS 1
+#endif
+#if ALEX_TRACK_LOOKUP_STATS
+#define ALEX_LOOKUP_STAT(stmt) stmt
+#else
+#define ALEX_LOOKUP_STAT(stmt)
+#endif
+
 namespace alex {
 
 /*** Linear model and model builder ***/
@@ -167,7 +181,7 @@ struct AlexCompare {
 // Extract the rightmost 1 in the binary representation.
 // e.g. extract_rightmost_one(010100100) = 000000100
 inline uint64_t extract_rightmost_one(uint64_t value) {
-  return value & -static_cast<int64_t>(value);
+  return value & (~value + 1);
 }
 
 // Remove the rightmost 1 in the binary representation.
